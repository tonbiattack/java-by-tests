---
/** Design system: 証明の作業台 — source/test panels are the evidence table, joined by a verification trace. */
import CodePanel from "./CodePanel.astro"; const {sourceFilename,testFilename,source,test}=Astro.props;
---
<section class="comparison" aria-label="Source と Test のコード比較"><CodePanel kind="Source" filename={sourceFilename} code={source}/><i><span>Source</span>✓<span>Test</span></i><CodePanel kind="Test" filename={testFilename} code={test}/></section><style>/* Design system: 証明の作業台 — green exists only as a central, verified source-to-test contract. */.comparison{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:2px;border:1px solid rgba(182,240,74,.48);background:rgba(182,240,74,.48);box-shadow:0 1.6rem 3rem rgba(0,0,0,.24)}.comparison:before{position:absolute;z-index:3;top:0;bottom:0;left:50%;width:1px;background:rgba(182,240,74,.85);content:""}.comparison>i{position:absolute;z-index:4;top:3.42rem;left:50%;display:grid;grid-template-columns:auto 1.55rem auto;align-items:center;gap:.35rem;color:var(--green);font-family:var(--code);font-size:.57rem;font-style:normal;letter-spacing:.06em;text-transform:uppercase;transform:translate(-50%,-50%)}.comparison>i:before,.comparison>i:after{width:1.5rem;height:1px;background:rgba(182,240,74,.68);content:""}.comparison>i span{display:none}.comparison>i{font-size:.72rem}.comparison>i::before{grid-column:1}.comparison>i::after{grid-column:3}.comparison>i{width:auto}.comparison>i{line-height:1}.comparison>i{color:var(--green)}.comparison>i{background:var(--ink);border:1px solid rgba(182,240,74,.7);border-radius:50%;display:grid;width:1.55rem;height:1.55rem;place-items:center}.comparison>i:before,.comparison>i:after{position:absolute;top:50%;background:rgba(182,240,74,.72)}.comparison>i:before{right:100%}.comparison>i:after{left:100%}@media(max-width:780px){.comparison{grid-template-columns:1fr}.comparison:before{top:50%;right:0;bottom:auto;left:0;width:auto;height:1px}.comparison>i{top:50%;right:1.1rem;left:auto;transform:translateY(-50%)}}</style>
