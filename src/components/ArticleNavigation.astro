---
/** Design system: 証明の作業台 — simple adjacent-proof navigation after evidence. */
import {lessons} from "../data/lessons";const {currentSlug}=Astro.props;const index=lessons.findIndex(l=>l.slug===currentSlug),previous=index>0?lessons[index-1]:null,next=index<lessons.length-1?lessons[index+1]:null;
---
<nav>{previous?<a href={`/java/${previous.slug}`}><small>← Previous</small><span>{previous.title}</span></a>:<i/>}{next?<a class="next" href={`/java/${next.slug}`}><small>Next →</small><span>{next.title}</span></a>:<i/>}</nav><style>/* Design system: 証明の作業台 — quiet linear transitions across lesson proofs. */nav{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:3.6rem;padding-top:1.15rem;border-top:1px solid var(--line)}nav a{display:grid;gap:.22rem;padding:.45rem 0;color:var(--muted)}nav a.next{text-align:right}nav a:hover{color:var(--green)}nav small{color:var(--dim);font-family:var(--code);font-size:.62rem;letter-spacing:.08em;text-transform:uppercase}nav span{font-family:var(--display);font-size:.88rem}</style>

