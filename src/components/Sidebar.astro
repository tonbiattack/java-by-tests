---
/** Design system: 証明の作業台 — サブパス配下でも証拠への導線を切らない固定ナビゲーション。 */
import { navigation } from "../data/lessons";
import { withBase } from "../lib/links";

type Props = { currentPath: string };
const { currentPath } = Astro.props;
const lessonCount = navigation.reduce((total, group) => total + group.items.length, 0);
---

<aside id="sidebar"><div><a class="brand" href={withBase()}><span class="brand-mark" aria-hidden="true"><i></i></span><span><small>Executable Documentation</small><strong>JAVA/<b>TESTS</b></strong></span></a><nav><a class:list={["root",{active:currentPath==="/"}]} href={withBase()}>Getting Started</a>{navigation.map(group=><section><h2>{group.label}</h2>{group.items.map(lesson=>{const logicalHref=`/java/${lesson.slug}`;return <a class:list={[{active:currentPath===logicalHref}]} href={withBase(logicalHref)}>{lesson.title.replace(/^(String|ArrayList|List\.of|record|Optional|Stream): /,"")}</a>})}</section>)}</nav></div><footer><i></i>Java 21 / JUnit 5 <span>{String(lessonCount).padStart(2,"0")} lessons</span></footer></aside>
<style>/* Design system: 証明の作業台 — the bracket/check mark makes the source-to-proof contract ownable. */aside{position:sticky;top:0;display:flex;height:100vh;flex-direction:column;justify-content:space-between;border-right:1px solid var(--line);background:#0a0f11}aside>div{overflow:auto;padding:1.45rem 1rem 1rem}.brand{display:flex;align-items:center;gap:.75rem;padding:.2rem .45rem 1.55rem;border-bottom:1px solid var(--line)}.brand-mark{position:relative;display:inline-block;width:2.45rem;height:2.45rem;border:2px solid var(--paper);border-top-color:rgba(239,245,242,.44);border-bottom-color:rgba(239,245,242,.44)}.brand-mark:before,.brand-mark:after{position:absolute;top:.5rem;bottom:.5rem;width:2px;background:var(--paper);content:""}.brand-mark:before{left:.52rem}.brand-mark:after{right:.52rem}.brand-mark i{position:absolute;z-index:1;top:.9rem;left:.8rem;width:.86rem;height:.46rem;border-bottom:3px solid var(--green);border-left:3px solid var(--green);transform:rotate(-45deg)}.brand span+span{display:grid;line-height:1}.brand small{margin-bottom:.32rem;color:var(--dim);font-family:var(--code);font-size:.54rem;letter-spacing:.07em;text-transform:uppercase}.brand strong{font-family:var(--display);font-size:.88rem;letter-spacing:.07em}.brand b{color:var(--green)}nav{padding-top:1.15rem}.root,section a{display:block;border-left:2px solid transparent;color:var(--muted);transition:color 160ms var(--ease),background 160ms var(--ease),border-color 160ms var(--ease)}.root{margin-bottom:1.15rem;padding:.5rem .55rem;font-family:var(--display);font-size:.86rem;font-weight:600}section{margin-top:1.15rem}section h2{margin:0 0 .35rem .58rem;color:var(--dim);font-family:var(--code);font-size:.63rem;font-weight:500;letter-spacing:.1em;text-transform:uppercase}section a{padding:.42rem .55rem;font-size:.8rem}.root:hover,section a:hover,.active{border-left-color:var(--green)!important;background:rgba(182,240,74,.07);color:var(--paper)!important}footer{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:.45rem;padding:.85rem 1rem;border-top:1px solid var(--line);color:var(--dim);font-family:var(--code);font-size:.58rem}footer i{width:.42rem;height:.42rem;border-radius:50%;background:var(--green)}@media(max-width:840px){aside{position:fixed;z-index:40;left:0;width:min(18.5rem,86vw);height:100dvh;transform:translateX(-104%);box-shadow:1rem 0 2.5rem #000;transition:transform 220ms var(--ease)}aside.open{transform:translateX(0)}}</style>
