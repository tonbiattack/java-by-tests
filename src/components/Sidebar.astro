---
/** Design system: 証明の作業台 — a fixed proof index keeps current location and language-switching visible without using verification green for passive state. */
import { lessons, navigation } from "../data/lessons";
import { withBase } from "../lib/links";

type Props = { currentPath: string };
const { currentPath } = Astro.props;
const lessonCount = navigation.reduce((total, group) => total + group.items.length, 0);
const proofIndex = new Map(lessons.map((lesson, index) => [lesson.slug, index + 1]));
---

<aside id="sidebar">
  <div>
    <a class="brand" href={withBase()}>
      <span class="brand-mark" aria-hidden="true"><i></i></span>
      <span><small>Executable Documentation</small><strong><span>JAVA</span><em>/</em><b>TESTS</b></strong></span>
    </a>
    <a class="language-link" href="https://tonbiattack.github.io/go-by-tests/" aria-label="Go by Testsを開く"><small>GO EDITION</small><strong>GO/<b>TESTS</b> →</strong></a>
    <nav aria-label="検証インデックス">
      <a class:list={["root", { active: currentPath === "/" }]} href={withBase()}><span>00</span>最初の検証</a>
      {navigation.map((group) => <section><h2>{group.label}</h2>{group.items.map((lesson) => { const logicalHref = `/java/${lesson.slug}`; return <a class:list={[{ active: currentPath === logicalHref }]} href={withBase(logicalHref)} aria-current={currentPath === logicalHref ? "page" : undefined}><span>{String(proofIndex.get(lesson.slug) ?? 0).padStart(2, "0")}</span>{lesson.title.replace(/^(String|ArrayList|List\.of|record|Optional|Stream): /, "")}</a>; })}</section>)}
    </nav>
  </div>
  <footer><i></i>Java 21 / JUnit 5 <span>{String(lessonCount).padStart(2, "0")} proofs</span></footer>
</aside>

<style>
  /* Design system: 証明の作業台 — bracket/check mark and numbered proof index establish the lab rail; green remains evidence-only. */
  aside{position:sticky;top:0;display:flex;height:100vh;flex-direction:column;justify-content:space-between;border-right:1px solid var(--line);background:#0a0f11}aside>div{overflow:auto;padding:1.45rem 1rem 1rem}.brand{display:flex;align-items:center;gap:.75rem;padding:.2rem .45rem 1.55rem;border-bottom:1px solid var(--line)}.brand-mark{position:relative;display:inline-block;width:2.55rem;height:2.55rem;border:2px solid var(--paper);border-top-color:rgba(239,245,242,.5);border-bottom-color:rgba(239,245,242,.5);box-shadow:inset 0 0 0 1px rgba(14,21,24,.9)}.brand-mark:before,.brand-mark:after{position:absolute;top:.5rem;bottom:.5rem;width:2px;background:var(--paper);content:""}.brand-mark:before{left:.52rem}.brand-mark:after{right:.52rem}.brand-mark i{position:absolute;z-index:1;top:.93rem;left:.84rem;width:.86rem;height:.46rem;border-bottom:3px solid var(--green);border-left:3px solid var(--green);transform:rotate(-45deg)}.brand span+span{display:grid;gap:.18rem;line-height:1}.brand small{color:var(--dim);font-family:var(--code);font-size:.54rem;letter-spacing:.1em;text-transform:uppercase}.brand strong{display:flex;align-items:baseline;color:var(--paper);font-family:var(--display);font-size:.92rem;letter-spacing:.115em}.brand strong span{font-weight:400}.brand strong em{margin:0 .04em;color:var(--dim);font-style:normal;font-weight:400}.brand b{color:var(--green);font-weight:700}
  .language-link{display:grid;gap:.18rem;margin:1rem .45rem 0;padding:.62rem .7rem;border:1px solid var(--line);border-left:2px solid var(--bright);background:rgba(145,177,186,.045);color:var(--muted);transition:color 160ms var(--ease),border-color 160ms var(--ease),background 160ms var(--ease)}.language-link:hover{border-color:var(--bright);background:rgba(145,177,186,.1);color:var(--paper)}.language-link small{color:var(--dim);font-family:var(--code);font-size:.54rem;letter-spacing:.1em}.language-link strong{font-family:var(--display);font-size:.78rem;letter-spacing:.09em}.language-link b{color:#00add8}
  nav{padding-top:1.15rem}.root,section a{display:grid;grid-template-columns:1.45rem minmax(0,1fr);gap:.35rem;border-left:2px solid transparent;color:var(--muted);transition:color 160ms var(--ease),background 160ms var(--ease),border-color 160ms var(--ease)}.root{margin-bottom:1.15rem;padding:.5rem .55rem;font-family:var(--display);font-size:.86rem;font-weight:600}nav a>span{color:var(--dim);font-family:var(--code);font-size:.56rem;letter-spacing:.04em}section{margin-top:1.15rem}section h2{margin:0 0 .35rem .58rem;color:var(--dim);font-family:var(--code);font-size:.63rem;font-weight:500;letter-spacing:.1em;text-transform:uppercase}section a{padding:.42rem .55rem;font-size:.8rem}.root:hover,section a:hover,.active{border-left-color:var(--bright)!important;background:rgba(145,177,186,.08);color:var(--paper)!important}.active>span{color:var(--bright)}footer{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:.45rem;padding:.85rem 1rem;border-top:1px solid var(--line);color:var(--dim);font-family:var(--code);font-size:.58rem}footer i{width:.42rem;height:.42rem;border-radius:50%;background:var(--bright)}
  @media(max-width:840px){aside{position:fixed;z-index:40;left:0;width:min(18.5rem,86vw);height:100dvh;transform:translateX(-104%);box-shadow:1rem 0 2.5rem #000;transition:transform 220ms var(--ease)}aside.open{transform:translateX(0)}}
</style>
