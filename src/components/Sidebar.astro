---
/** Design system: 証明の作業台 — a fixed proof index keeps current location and language-switching visible without using verification green for passive state. */
import { lessons, navigation } from "../data/lessons";
import { withBase } from "../lib/links";

type Props = { currentPath: string };
const { currentPath } = Astro.props;
const lessonCount = navigation.reduce(
  (total, group) => total + group.items.length,
  0
);
const proofIndex = new Map(
  lessons.map((lesson, index) => [lesson.slug, index + 1])
);
---

<aside id="sidebar">
  <div>
    <a class="brand" href={withBase()}>
      <span class="brand-mark" aria-hidden="true"><i></i></span>
      <span
        ><small>Executable Documentation</small><strong
          ><span>JAVA</span><em>/</em><b>TESTS</b></strong
        ></span
      >
    </a>
    <a
      class="language-link"
      href="https://tonbiattack.github.io/go-by-tests/"
      aria-label="Go by Testsを開く"
      ><small>GO EDITION</small><strong>GO/<b>TESTS</b> →</strong></a
    >
    <a
      class="language-link typescript-link"
      href="https://tonbiattack.github.io/typescript-by-tests/"
      aria-label="TypeScript by Testsを開く"
      ><small>TYPE SCRIPT EDITION</small><strong>TS/<b>TESTS</b> →</strong></a
    >
    <a
      class="language-link python-link"
      href="https://tonbiattack.github.io/python-by-tests/"
      aria-label="Python by Testsを開く"
      ><small>PYTHON EDITION</small><strong>PY/<b>TESTS</b> →</strong></a
    >
    <section class="repository-links" aria-labelledby="repository-links-title">
      <h2 id="repository-links-title">GitHub repositories</h2>
      <a
        href="https://github.com/tonbiattack/java-by-tests"
        target="_blank"
        rel="noreferrer"
        aria-label="Java by TestsのGitHubリポジトリを新しいタブで開く"
        ><span>JAVA</span><strong>Java by Tests</strong><i aria-hidden="true"
          >↗</i
        ></a
      >
      <a
        href="https://github.com/tonbiattack/typescript-by-tests"
        target="_blank"
        rel="noreferrer"
        aria-label="TypeScript by TestsのGitHubリポジトリを新しいタブで開く"
        ><span>TS</span><strong>TypeScript by Tests</strong><i
          aria-hidden="true">↗</i
        ></a
      >
      <a
        href="https://github.com/tonbiattack/go-by-tests"
        target="_blank"
        rel="noreferrer"
        aria-label="Go by TestsのGitHubリポジトリを新しいタブで開く"
        ><span>GO</span><strong>Go by Tests</strong><i aria-hidden="true">↗</i
        ></a
      >
      <a
        href="https://github.com/tonbiattack/python-by-tests"
        target="_blank"
        rel="noreferrer"
        aria-label="Python by TestsのGitHubリポジトリを新しいタブで開く"
        ><span>PY</span><strong>Python by Tests</strong><i aria-hidden="true">↗</i
        ></a
      >
    </section>
    <nav aria-label="検証インデックス">
      <a
        class:list={["root", { active: currentPath === "/" }]}
        href={withBase()}><span>00</span>最初の検証</a
      >
      {
        navigation.map(group => (
          <section>
            <h2>{group.label}</h2>
            {group.items.map(lesson => {
              const logicalHref = `/java/${lesson.slug}`;
              return (
                <a
                  class:list={[{ active: currentPath === logicalHref }]}
                  href={withBase(logicalHref)}
                  aria-current={
                    currentPath === logicalHref ? "page" : undefined
                  }
                >
                  <span>
                    {String(proofIndex.get(lesson.slug) ?? 0).padStart(2, "0")}
                  </span>
                  {lesson.title.replace(
                    /^(String|ArrayList|List\.of|record|Optional|Stream): /,
                    ""
                  )}
                </a>
              );
            })}
          </section>
        ))
      }
    </nav>
  </div>
  <footer>
    <i></i>Java 21 / JUnit 5 <span
      >{String(lessonCount).padStart(2, "0")} proofs</span>
  </footer>
</aside>

<style>
  /* Design system: 証明の作業台 — bracket/check mark and numbered proof index establish the lab rail; green remains evidence-only. */
  aside {
    position: sticky;
    top: 0;
    display: flex;
    height: 100vh;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid var(--line);
    background: #0a0f11;
  }
  aside > div {
    overflow: auto;
    padding: 1.45rem 1rem 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.2rem 0.45rem 1.55rem;
    border-bottom: 1px solid var(--line);
  }
  .brand-mark {
    position: relative;
    display: inline-block;
    width: 2.55rem;
    height: 2.55rem;
    border: 2px solid var(--paper);
    border-top-color: rgba(239, 245, 242, 0.5);
    border-bottom-color: rgba(239, 245, 242, 0.5);
    box-shadow: inset 0 0 0 1px rgba(14, 21, 24, 0.9);
  }
  .brand-mark:before,
  .brand-mark:after {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--paper);
    content: "";
  }
  .brand-mark:before {
    left: 0.52rem;
  }
  .brand-mark:after {
    right: 0.52rem;
  }
  .brand-mark i {
    position: absolute;
    z-index: 1;
    top: 0.93rem;
    left: 0.84rem;
    width: 0.86rem;
    height: 0.46rem;
    border-bottom: 3px solid var(--green);
    border-left: 3px solid var(--green);
    transform: rotate(-45deg);
  }
  .brand span + span {
    display: grid;
    gap: 0.18rem;
    line-height: 1;
  }
  .brand small {
    color: var(--dim);
    font-family: var(--code);
    font-size: 0.54rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .brand strong {
    display: flex;
    align-items: baseline;
    color: var(--paper);
    font-family: var(--display);
    font-size: 0.92rem;
    letter-spacing: 0.115em;
  }
  .brand strong span {
    font-weight: 400;
  }
  .brand strong em {
    margin: 0 0.04em;
    color: var(--dim);
    font-style: normal;
    font-weight: 400;
  }
  .brand b {
    color: var(--green);
    font-weight: 700;
  }
  .language-link {
    display: grid;
    gap: 0.18rem;
    margin: 1rem 0.45rem 0;
    padding: 0.62rem 0.7rem;
    border: 1px solid var(--line);
    border-left: 2px solid var(--bright);
    background: rgba(145, 177, 186, 0.045);
    color: var(--muted);
    transition:
      color 160ms var(--ease),
      border-color 160ms var(--ease),
      background 160ms var(--ease);
  }
  .language-link + .language-link {
    margin-top: 0.5rem;
  }
  .language-link:hover {
    border-color: var(--bright);
    background: rgba(145, 177, 186, 0.1);
    color: var(--paper);
  }
  .language-link small {
    color: var(--dim);
    font-family: var(--code);
    font-size: 0.54rem;
    letter-spacing: 0.1em;
  }
  .language-link strong {
    font-family: var(--display);
    font-size: 0.78rem;
    letter-spacing: 0.09em;
  }
  .language-link b {
    color: #00add8;
  }
  .typescript-link b {
    color: #3178c6;
  }
  .repository-links {
    margin: 1.35rem 0.45rem 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .repository-links h2 {
    margin: 0 0 0.45rem;
    color: var(--dim);
    font-family: var(--code);
    font-size: 0.54rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .repository-links a {
    display: grid;
    grid-template-columns: 1.65rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.35rem;
    padding: 0.42rem 0.2rem;
    border-left: 2px solid transparent;
    color: var(--muted);
    font-family: var(--code);
    font-size: 0.62rem;
    letter-spacing: 0.035em;
    transition:
      color 160ms var(--ease),
      background 160ms var(--ease),
      border-color 160ms var(--ease);
  }
  .repository-links a:hover {
    border-left-color: var(--bright);
    background: rgba(145, 177, 186, 0.08);
    color: var(--paper);
  }
  .repository-links span {
    color: var(--bright);
    font-size: 0.54rem;
  }
  .repository-links strong {
    font-weight: 400;
  }
  .repository-links i {
    color: var(--dim);
    font-size: 0.72rem;
    font-style: normal;
  }
  nav {
    padding-top: 1.15rem;
  }
  .root,
  section a {
    display: grid;
    grid-template-columns: 1.45rem minmax(0, 1fr);
    gap: 0.35rem;
    border-left: 2px solid transparent;
    color: var(--muted);
    transition:
      color 160ms var(--ease),
      background 160ms var(--ease),
      border-color 160ms var(--ease);
  }
  .root {
    margin-bottom: 1.15rem;
    padding: 0.5rem 0.55rem;
    font-family: var(--display);
    font-size: 0.86rem;
    font-weight: 600;
  }
  nav a > span {
    color: var(--dim);
    font-family: var(--code);
    font-size: 0.56rem;
    letter-spacing: 0.04em;
  }
  section {
    margin-top: 1.15rem;
  }
  section h2 {
    margin: 0 0 0.35rem 0.58rem;
    color: var(--dim);
    font-family: var(--code);
    font-size: 0.63rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  section a {
    padding: 0.42rem 0.55rem;
    font-size: 0.8rem;
  }
  .root:hover,
  section a:hover,
  .active {
    border-left-color: var(--bright) !important;
    background: rgba(145, 177, 186, 0.08);
    color: var(--paper) !important;
  }
  .active > span {
    color: var(--bright);
  }
  footer {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.45rem;
    padding: 0.85rem 1rem;
    border-top: 1px solid var(--line);
    color: var(--dim);
    font-family: var(--code);
    font-size: 0.58rem;
  }
  footer i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--bright);
  }
  @media (max-width: 840px) {
    aside {
      position: fixed;
      z-index: 40;
      left: 0;
      width: min(18.5rem, 86vw);
      height: 100dvh;
      transform: translateX(-104%);
      box-shadow: 1rem 0 2.5rem #000;
      transition: transform 220ms var(--ease);
    }
    aside.open {
      transform: translateX(0);
    }
  }
</style>
