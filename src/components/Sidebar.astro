---
/** Design system: 証明の作業台 — a fixed navigation rail preserves context without borrowing verification green for passive state. */
import { navigation } from "../data/lessons";
import { withBase } from "../lib/links";

type Props = { currentPath: string };
const { currentPath } = Astro.props;
const lessonCount = navigation.reduce((total, group) => total + group.items.length, 0);
---

<aside id="sidebar">
  <div>
    <a class="brand" href={withBase()}>
      <span class="brand-mark" aria-hidden="true"><i></i></span>
      <span>
        <small>Executable Documentation</small>
        <strong><span>JAVA</span><em>/</em><b>TESTS</b></strong>
      </span>
    </a>
    <a class="language-link" href="https://tonbiattack.github.io/go-by-tests/" aria-label="Go by Testsを開く"><small>GO EDITION</small><strong>GO/<b>TESTS</b> →</strong></a>
    <nav>
      <a class:list={["root", { active: currentPath === "/" }]} href={withBase()}>Getting Started</a>
      {
        navigation.map((group) => (
          <section>
            <h2>{group.label}</h2>
            {
              group.items.map((lesson) => {
                const logicalHref = `/java/${lesson.slug}`;
                return (
                  <a class:list={[{ active: currentPath === logicalHref }]} href={withBase(logicalHref)}>
                    {lesson.title.replace(/^(String|ArrayList|List\.of|record|Optional|Stream): /, "")}
                  </a>
                );
              })
            }
          </section>
        ))
      }
    </nav>
  </div>
  <footer><i></i>Java 21 / JUnit 5 <span>{String(lessonCount).padStart(2, "0")} lessons</span></footer>
</aside>

<style>
  /* Design system: 証明の作業台 — the bracket/check mark is the ownable brand signal; green stays reserved for verified evidence. */
  aside {
    position: sticky;
    top: 0;
    display: flex;
    height: 100vh;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid var(--line);
    background: #0a0f11;
  }

  aside > div {
    overflow: auto;
    padding: 1.45rem 1rem 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.2rem 0.45rem 1.55rem;
    border-bottom: 1px solid var(--line);
  }

  .brand-mark {
    position: relative;
    display: inline-block;
    width: 2.55rem;
    height: 2.55rem;
    border: 2px solid var(--paper);
    border-top-color: rgba(239, 245, 242, 0.5);
    border-bottom-color: rgba(239, 245, 242, 0.5);
    box-shadow: inset 0 0 0 1px rgba(14, 21, 24, 0.9);
  }

  .brand-mark:before,
  .brand-mark:after {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--paper);
    content: "";
  }

  .brand-mark:before {
    left: 0.52rem;
  }

  .brand-mark:after {
    right: 0.52rem;
  }

  .brand-mark i {
    position: absolute;
    z-index: 1;
    top: 0.93rem;
    left: 0.84rem;
    width: 0.86rem;
    height: 0.46rem;
    border-bottom: 3px solid var(--green);
    border-left: 3px solid var(--green);
    transform: rotate(-45deg);
  }

  .brand span + span {
    display: grid;
    gap: 0.18rem;
    line-height: 1;
  }

  .brand small {
    color: var(--dim);
    font-family: var(--code);
    font-size: 0.54rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .brand strong {
    display: flex;
    align-items: baseline;
    color: var(--paper);
    font-family: var(--display);
    font-size: 0.92rem;
    letter-spacing: 0.115em;
  }

  .brand strong span {
    font-weight: 400;
  }

  .brand strong em {
    margin: 0 0.04em;
    color: var(--dim);
    font-style: normal;
    font-weight: 400;
  }

  .brand b {
    color: var(--green);
    font-weight: 700;
  }

  .language-link {
    display: grid;
    gap: 0.18rem;
    margin: 1rem 0.45rem 0;
    padding: 0.62rem 0.7rem;
    border: 1px solid var(--line);
    border-left: 2px solid var(--bright);
    background: rgba(145, 177, 186, 0.045);
    color: var(--muted);
    transition: color 160ms var(--ease), border-color 160ms var(--ease), background 160ms var(--ease);
  }

  .language-link:hover {
    border-color: var(--bright);
    background: rgba(145, 177, 186, 0.1);
    color: var(--paper);
  }

  .language-link small {
    color: var(--dim);
    font-family: var(--code);
    font-size: 0.54rem;
    letter-spacing: 0.1em;
  }

  .language-link strong {
    font-family: var(--display);
    font-size: 0.78rem;
    letter-spacing: 0.09em;
  }

  .language-link b {
    color: #00add8;
  }

  nav {
    padding-top: 1.15rem;
  }

  .root,
  section a {
    display: block;
    border-left: 2px solid transparent;
    color: var(--muted);
    transition: color 160ms var(--ease), background 160ms var(--ease), border-color 160ms var(--ease);
  }

  .root {
    margin-bottom: 1.15rem;
    padding: 0.5rem 0.55rem;
    font-family: var(--display);
    font-size: 0.86rem;
    font-weight: 600;
  }

  section {
    margin-top: 1.15rem;
  }

  section h2 {
    margin: 0 0 0.35rem 0.58rem;
    color: var(--dim);
    font-family: var(--code);
    font-size: 0.63rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  section a {
    padding: 0.42rem 0.55rem;
    font-size: 0.8rem;
  }

  .root:hover,
  section a:hover,
  .active {
    border-left-color: var(--bright) !important;
    background: rgba(145, 177, 186, 0.08);
    color: var(--paper) !important;
  }

  footer {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.45rem;
    padding: 0.85rem 1rem;
    border-top: 1px solid var(--line);
    color: var(--dim);
    font-family: var(--code);
    font-size: 0.58rem;
  }

  footer i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--bright);
  }

  @media (max-width: 840px) {
    aside {
      position: fixed;
      z-index: 40;
      left: 0;
      width: min(18.5rem, 86vw);
      height: 100dvh;
      transform: translateX(-104%);
      box-shadow: 1rem 0 2.5rem #000;
      transition: transform 220ms var(--ease);
    }

    aside.open {
      transform: translateX(0);
    }
  }
</style>
