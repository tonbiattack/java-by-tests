---
/** Design system: 証明の作業台 — version is neutral metadata; verification green belongs only to proven results. */
const {version}=Astro.props;
---
<span class="badge">{version}</span><style>/* Design system: 証明の作業台 — rectangular monospace metadata badge. */.badge{display:inline-flex;padding:.22rem .42rem;border:1px solid var(--line);background:rgba(145,177,186,.045);color:var(--muted);font-family:var(--code);font-size:.66rem;letter-spacing:.035em}</style>
