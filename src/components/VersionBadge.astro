---
/** Design system: 証明の作業台 — version is neutral metadata; verification green belongs only to proven results. */
const { version } = Astro.props;
---

<span class="badge">{version}</span><style>
  /* Design system: 証明の作業台 — rectangular monospace metadata badge. */
  .badge {
    display: inline-flex;
    padding: 0.22rem 0.42rem;
    border: 1px solid var(--line);
    background: rgba(145, 177, 186, 0.045);
    color: var(--muted);
    font-family: var(--code);
    font-size: 0.66rem;
    letter-spacing: 0.035em;
  }
</style>
