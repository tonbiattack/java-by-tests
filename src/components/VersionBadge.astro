---
/** Design system: 証明の作業台 — concise factual Java-version metadata. */
const {version}=Astro.props;
---
<span class="badge">{version}</span><style>/* Design system: 証明の作業台 — rectangular monospace badge. */.badge{display:inline-flex;padding:.22rem .42rem;border:1px solid rgba(182,240,74,.36);background:rgba(182,240,74,.07);color:var(--green);font-family:var(--code);font-size:.66rem;letter-spacing:.035em}</style>
