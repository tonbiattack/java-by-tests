{
  "name": "java-by-tests",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Java 21とJUnit 5で仕様を確かめる実行可能ドキュメント学習サイト",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "typecheck": "astro check",
    "build": "astro check && astro build",
    "verify:links": "node scripts/verify-pages-links.mjs",
    "test:java": "mvn -B -f examples/pom.xml test",
    "verify": "pnpm typecheck && pnpm test:java && GITHUB_ACTIONS=true pnpm build && pnpm verify:links",
    "preview": "astro preview --host 0.0.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@types/node": "^22.20.1",
    "astro": "5.16.11",
    "shiki": "1.29.2",
    "typescript": "5.6.3"
  }
}
